"color_heading_highlight_light":"rgba(0,0,0,0)","text_light":"rgba(0,0,0,0)","background_color_light":"rgba(0,0,0,0)","heading_dark":"rgba(0,0,0,0)","color_heading_highlight_dark":"rgba(0,0,0,0)","text_dark":"rgba(0,0,0,0)","background_color_dark":"rgba(0,0,0,0)","content_alignment":"center","show_section_divider":false,"make_full_page_width":true,"padding_top":28,"padding_bottom":28,"content_alignment_mobile":"center","show_section_divider_mobile":false,"padding_top_mobile":28,"padding_bottom_mobile":28}},"17705984447ec9cc81":{"type":"apps","blocks":{"judge_me_reviews_review_widget_Tgibwj":{"type":"shopify:\/\/apps\/judge-me-reviews\/blocks\/review_widget\/61ccd3b1-a9f2-4160-9fe9-4fec8413e5d8","settings":{"review_data":"sample_data","max_width":1200,"show_shop_reviews":false,"empty_state":"empty_widget"}}},"block_order":["judge_me_reviews_review_widget_Tgibwj"],"settings":{"include_margins":true}},"rich_text_zKFChV":{"type":"rich-text","blocks":{"heading_Teg4P3":{"type":"heading","settings":{"heading":"30 Tage Komfort-Garantie","highlight_type":"underline","heading_size":100,"heading_tag":"h2"}},"text_ngedhL":{"type":"text","settings":{"text":"<p>Teste CLYPS risikofrei. Wenn es drückt – Geld zurück.<\/p>","number_of_lines_shown":"none","read_more_label":"Read more","see_less_label":"See less"}},"caption_kz3bRX":{"type":"caption","settings":{"caption":"✓ 30 Tage testen  ✓ Kostenloser Rückversand ✓ Geld-zurück-Garantie","text_style":"uppercase","text_size":100}}},"block_order":["heading_Teg4P3","text_ngedhL","caption_kz3bRX"],"name":"t:sections.rich-text.name","settings":{"heading_light":"#4e3919","color_heading_highlight_light":"rgba(0,0,0,0)","text_light":"#aca49b","background_color_light":"#f2efeb","heading_dark":"rgba(0,0,0,0)","color_heading_highlight_dark":"rgba(0,0,0,0)","text_dark":"rgba(0,0,0,0)","background_color_dark":"rgba(0,0,0,0)","content_alignment":"center","show_section_divider":false,"make_full_page_width":true,"padding_top":36,"padding_bottom":36,"content_alignment_mobile":"center","show_section_divider_mobile":false,"padding_top_mobile":28,"padding_bottom_mobile":28}},"faq_CnRcJV":{"type":"faq","blocks":{"frequently_asked_question_z9jNyy":{"type":"frequently_asked_question","settings":{"icon":"none","another_icon":"","custom_icon":"","heading":"Brauche ich Ohrlöcher für Ohrclips?","row_content":"<p>Nein. Genau dafür sind sie gemacht. Unsere CLYPS sitzen sicher am Ohrläppchen, ganz ohne Nadel oder Stich. <\/p>"}},"frequently_asked_question_77V7KL":{"type":"frequently_asked_question","settings":{"icon":"none","another_icon":"","custom_icon":"","heading":"Halten CLYPS sicher am Ohr?","row_content":"<p>Ja, unsere CLYPS sitzen zuverlässig am Ohrläppchen. <br\/><br\/>Der <strong>Everyday Clip<\/strong> aus weichem, flexiblem Kunstharz passt sich deinem Ohrläppchen flexibel an und findet die ideale Balance aus Komfort und Halt für den Alltag. So bequem, dass du vergisst, dass du ihn trägst. <br\/><br\/>Der <strong>Superstay Clip<\/strong> mit Feder-Mechanismus sitzt fest und eng am Ohrläppchen. Ideal für alle, die Statement-Clips lieben und auch die wildeste Tanzparty sorglos durchzieht.<\/p>"}},"frequently_asked_question_iRheQG":{"type":"frequently_asked_question","settings":{"icon":"none","another_icon":"","custom_icon":"","heading":"Sieht man, dass es Ohrclips sind?","row_content":"<p>Nein. Unsere Clipverschlüsse sind aus durchsichtigem Kunstharz und verstecken sich diskret hinter dem Ohrring.<\/p>"}},"frequently_asked_question_pYGGmm":{"type":"frequently_asked_question","settings":{"icon":"none","another_icon":"","custom_icon":"","heading":"Sind CLYPS schmerzhaft?","row_content":"<p>Das kennen viele von günstigeren Clips. CLYPS löst das anders. Der Everyday Clip sitzt weich und flexibel, der Superstay Clip fest aber kontrolliert.<\/p>"}},"frequently_asked_question_KJPMV4":{"type":"frequently_asked_question","settings":{"icon":"none","another_icon":"","custom_icon":"","heading":"Welchen Clip-Typ sollte ich wählen?","row_content":"<p>Das kommt auf Faktoren wie dein individuelles Schmerzempinden aber auch den Verwendungszweck an. Unsere Clip Guide findest du hier. <\/p>"}},"frequently_asked_question_9XpnQ7":{"type":"frequently_asked_question","settings":{"icon":"none","another_icon":"","custom_icon":"","heading":"Wie lange kann ich CLYPS tragen?","row_content":"<p>Das ist sehr individuell und hängt von deinem Ohrläppchen und dem Clip-Typ ab.<br\/><br\/>Den Everyday Clip kannst du problemlos den ganzen Tag tragen. <br\/>Der Superstay Clip eignet sich problemlos für mehrere Stunden. <br\/><br\/>Weitere Infos findest du in unserem Clip-Guide. <\/p>"}}},"block_order":["frequently_asked_question_z9jNyy","frequently_asked_question_77V7KL","frequently_asked_question_iRheQG","frequently_asked_question_pYGGmm","frequently_asked_question_KJPMV4","frequently_asked_question_9XpnQ7"],"name":"t:sections.question_and_answer.name","settings":{"heading":"FAQs","highlight_type":"underline","heading_size":100,"heading_tag":"h2","heading_alignment":"center","show_border":false,"row_background":false,"collapsible":true,"show_view_all":false,"view_all_position":"top","button_link":"","open_new_window":false,"background_color_light":"rgba(0,0,0,0)","background_color_dark":"rgba(0,0,0,0)","enable_microdata_schema":false,"desktop_layout":"2","image_alignment":"left","desktop_height":"400px","show_section_divider":false,"make_full_page_width":false,"padding_top":28,"padding_bottom":28,"image_alignment_mobile":"left","mobile_height":"250px","show_section_divider_mobile":false,"padding_top_mobile":28,"padding_bottom_mobile":28}},"product-recommendations":{"type":"product-recommendations","settings":{"heading":"Diese CLYPS würden dir auch stehen 🤍","highlight_type":"font_highlight","heading_size":100,"heading_tag":"h2","heading_alignment":"center","products_to_show":7,"background_color_light":"","background_color_dark":"","show_vendor":false,"show_rating":false,"show_highlighted_features":false,"show_hi