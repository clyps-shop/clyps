w_button_style_1":"primary","button_label_2":"","button_link_2":"","open_new_window_button_2":false,"show_button_style_2":"primary","color_button":"rgba(0,0,0,0)","color_text_button":"rgba(0,0,0,0)","color_button_hover":"rgba(0,0,0,0)","color_text_button_hover":"rgba(0,0,0,0)","color_button_secondary":"rgba(0,0,0,0)","secondary_button_text":"rgba(0,0,0,0)","colors_text_link":"rgba(0,0,0,0)"}}},"block_order":["heading_RhEfrH","text_JJiH6Q","button_HMBQbG"],"name":"t:sections.rich-text.name","settings":{"heading_light":"rgba(0,0,0,0)","color_heading_highlight_light":"rgba(0,0,0,0)","text_light":"rgba(0,0,0,0)","background_color_light":"#f2efeb","heading_dark":"rgba(0,0,0,0)","color_heading_highlight_dark":"rgba(0,0,0,0)","text_dark":"rgba(0,0,0,0)","background_color_dark":"rgba(0,0,0,0)","content_alignment":"center","show_section_divider":false,"make_full_page_width":true,"padding_top":28,"padding_bottom":28,"content_alignment_mobile":"center","show_section_divider_mobile":false,"padding_top_mobile":28,"padding_bottom_mobile":28}},"flow_UYF9aB":{"type":"flow","blocks":{"media_GVPRhb":{"type":"media","settings":{"image":"shopify:\/\/shop_images\/DSC07826.png","show_sound_control":false,"video_url":"","video_alt_text":"","enable_video_autoplay":false,"subheading":"","heading":"Aufbewahrung","image_style_heading":"square","image_ratio_heading":"aspect-16\/9","description":"<p>Damit deine CLYPS lange schön bleiben:<\/p><ul><li>Im Wildledertäschchen aufbewahren<\/li><li>Trocken & lichtgeschützt lagern<\/li><li>Getrennt voneinander (damit nichts reibt\/kratzt)<\/li><\/ul>","button_text":"","button_link":"","open_new_window_button":false,"show_button_style":"primary"}},"media_pJwbLa":{"type":"media","settings":{"image":"shopify:\/\/shop_images\/DSC07834.png","show_sound_control":false,"video_url":"","video_alt_text":"","enable_video_autoplay":false,"subheading":"","heading":"Reinigung","image_style_heading":"square","image_ratio_heading":"aspect-16\/9","description":"<p>So bleiben deine CLYPS sauber & glänzend:<\/p><ul><li>Nach dem Tragen kurz mit mitgeliefertem Mikrofasertuch abwischen<\/li><li>Bei Bedarf: lauwarmes Wasser + pH-neutrale Seife, kurz reinigen, abspülen, gut trocknen<\/li><li>Nach Meer\/ Pool: einmal mit klarem Wasser abspülen und trocken tupfen<\/li><\/ul>","button_text":"","button_link":"","open_new_window_button":false,"show_button_style":"primary"}},"media_xVmErJ":{"type":"media","settings":{"image":"shopify:\/\/shop_images\/IMG_6417.png","show_sound_control":false,"video_url":"","video_alt_text":"","enable_video_autoplay":false,"subheading":"","heading":"Getting ready","image_style_heading":"square","image_ratio_heading":"aspect-16\/9","description":"<p>CLYPS sind der Feinschliff für deinen Look.<\/p><ul><li>Zuletzt anlegen: Nach Make-up, Parfüm & Haarspray usw.<\/li><li>Zuerst ablegen: Bevor du dich abschminkst oder Pflegeprodukte nutzt<\/li><\/ul>","button_text":"","button_link":"","open_new_window_button":false,"show_button_style":"primary"}}},"block_order":["media_GVPRhb","media_pJwbLa","media_xVmErJ"],"name":"Pflege","settings":{"heading":"","highlight_type":"font_highlight","heading_size":100,"heading_tag":"h2","heading_alignment":"center","content_position":"middle","content_alignment":"left","select_motion":"hover","open_first_tab":true,"adapt_radius":true,"image_corner_radius":0,"auto_play":false,"change_steps_speed":5,"pause_hover":true,"background_color":"rgba(0,0,0,0)","heading_color":"#aca49b","text_color":"rgba(0,0,0,0)","background_color_dark":"rgba(0,0,0,0)","heading_color_dark":"rgba(0,0,0,0)","text_color_dark":"rgba(0,0,0,0)","image_position":"second","full_width":false,"padding_full_width":false,"show_section_divider":false,"desktop_height":"650px","padding_top":28,"padding_bottom":28,"image_position_mobile":"second","full_width_mobile":false,"show_section_divider_mobile":false,"mobile_height":"400px","padding_top_mobile":28,"padding_bottom_mobile":28}},"faq_7cmnKC":{"type":"faq","blocks":{"category_bbCQCM":{"type":"category","settings":{"icon":"none","another_icon":"","custom_icon":"","icon_size":28,"title":"Material"}},"frequently_asked_question_8PhFL9":{"type":"frequently_asked_question","name":"Sind CLYPS hautverträglich?","settings":{"icon":"none","another_icon":"","custom_icon":"","heading":"Sind CLYPS hautverträglich?","row_content":"<p>Ja, sie sind besonder hautverträglich und wir erklären auch warum. Unsere CLYPS bestehen aus hochwertigem Edelstahl mit PVD-Beschichtung. Die Beschichtung versiegelt die Oberfläche vollständig, sodass keine Metallionen nach außen treten können. Der Clipverschluss besteht aus Kunstharz und ist damit metallfrei, auch nickelfrei.<\/p><p>Zur Einordnung: Echter „nickelfrei\" Schmuck existiert kaum – wer Schmuck als „nickelfrei\" bewirbt, muss sicherstellen, dass tatsächlich keinerlei Nickel enthalten ist, und nur sehr wenige Legierungen sind tatsächlich frei von Nickel. Deshalb sprechen wir bewusst von hautverträglich statt nickelfrei. <\/p>"}},"frequently_asked_question_WfwAeK":{"type":"frequently_asked_question","name":"Was ist PVD-Beschichtung?","settings":{"icon":"none","another_icon":"","custom_icon":"","heading":"Was ist PVD-Beschichtung?","row_content":"<p>PVD steht für Physical Vapor Deposition. Ein High-Tech-Verfahren, bei dem das Finish im Vakuum aufgedampft und fest mit dem Edelstahl verbunden wird. <br\/>So entsteht eine versiegelte Schutzschicht, die kratz- & abriebfest, wasserfest und farbecht ist. Die Farbe bleibt dauerhaft erhalten und läuft nicht an.<\/p>"}},"frequently_asked_question_frwFPc":{"type":"frequently_asked_question","name":"Läuft die Beschichtung an oder verfärbt sie sich?","settings":{"icon":"none","another_icon":"","custom_icon":"","heading":"Läuft die Beschichtung an oder verfärbt sie sich?","row_content":"<p>Nein. Dank PVD-Beschichtung bleibt die Farbe dauerhaft erhalten – sie läuft nicht an und verfärbt sich nicht. Anders als bei normaler Vergoldung ist die PVD-Schicht fest mit dem Edelstahl verbunden und deutlich widerstandsfähiger gegen Alltag, Wasser und Abrieb.<\/p>"}},"frequently_asked_question_CLY3FV":{"type":"frequently_asked_question","name":"Sind CLYPS wasserfest?","settings":{"icon":"none","another_icon":"","custom_icon":"","heading":"Sind CLYPS wasserfest?","row_content":"<p>Das kommt auf den Clip-Typ an. <br\/>Die Ohrringe selbst sind dank PVD-Beschichtung und hochwertigem Edelstahl vollständig wasserfest. <br\/><br\/>Der <strong>Everyday Clip<\/strong> aus Kunstharz ebenfalls – Duschen, Schwimmen und Alltag kein Problem. <br\/><br\/>Beim <strong>Superstay Clip<\/strong> empfehlen wir jedoch, Wasserkontakt zu vermeiden, da die Metallspirale rosten kann. Nach dem Meer oder Pool immer einmal mit klarem Wasser abspülen und trocken tupfen.<\/p>"}},"category_fwnJLM":{"type":"category","settings":{"icon":"none","another_icon":"","custom_icon":"","icon_size":28,"title":"Pflege"}},"frequently_asked_question_k8Rzj7":{"type":"frequently_asked_question","name":"Wie reinige ich meine CLYPS?","settings":{"icon":"none","another_icon":"","custom_icon":"","heading":"Wie reinige ich meine CLYPS?","row_content":"<p>Nach dem Tragen einfach kurz mit dem mitgelieferten Mikrofasertuch abwischen – das reicht für den Alltag.<br\/>Bei Bedarf mit lauwarmem Wasser und pH-neutraler Seife kurz reinigen, abspülen und gut trocknen. Nach Meer oder Pool einmal mit klarem Wasser abspülen und trocken tupfen.<\/p>"}},"frequently_asked_question_DwzrGa":{"type":"frequently_asked_question","name":"Wie bewahre ich meine CLYPS auf?","settings":{"icon":"none","another_icon":"","custom_icon":"","heading":"Wie bewahre ich meine CLYPS auf?","row_content":"<p>Im mitgelieferten Wildledertäschchen – trocken, lichtgeschützt und getrennt von anderem Schmuck, damit nichts reibt oder kratzt. So bleiben sie lange schön glänzend.<\/p>"}},"frequently_asked_question_NJKYEJ":{"type":"frequently_asked_question","name":"Wann lege ich meine CLYPS an und ab?","settings":{"icon":"none","another_icon":"","custom_icon":"","heading":"Wann lege ich meine CLYPS an und ab?","row_content":"<p>CLYPS immer zuletzt anlegen – nach Make-up, Parfüm & Haarspray. <br\/>Und als erstes ablegen, bevor du Pflegeprodukte oder Cremes nutzt. So bleibt die PVD-Beschichtung lange schön und geschützt.<\/p>"}}},"block_order":["category_bbCQCM","frequently_asked_question_8PhFL9","frequently_asked_question_WfwAeK","frequently_asked_question_frwFPc","frequently_asked_question_CLY3FV","category_fwnJLM","frequently_asked_question_k8Rzj7","frequently_asked_question_DwzrGa","frequently_asked_question_NJKYEJ"],"name":"t:sections.question_and_answer.name","settings":{"heading":"FAQs","highlight_type":"underline","heading_size":100,"heading_tag":"h2","heading_alignment":"center","show_border":false,"row_background":true,"collapsible":true,"show_view_all":true,"view_all_position":"top","button_link":"shopify:\/\/pages\/faqs","open_new_window":false,"background_color_light":"rgba(0,0,0,0)","background_color_dark":"rgba(0,0,0,0)","enable_microdata_schema":false,"desktop_layout":"2","image_alignment":"left","desktop_height":"400px","show_section_divider":false,"make_full_page_width":false,"padding_top":28,"padding_bottom":28,"image_alignment_mobile":"left","mobile_height":"250px","show_section_divider_mobile":false,"padding_top_mobile":28,"padding_bottom_mobile":28}}},"order":["rich_text_gRULJz","text_column_with_image_HJVmyR","rich_text_gBhTtU","promotion_banner_H7ReGy","rich_text_WDkKq3","main","image_with_text_jrzVHd","flexible_area_JGHmjU","rich_text_UidEQJ","flow_UYF9aB","faq_7cmnKC"]}