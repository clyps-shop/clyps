      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48,
      "label": "t:sections.clyps_bundle_builder.settings.padding_top.label"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48,
      "label": "t:sections.clyps_bundle_builder.settings.padding_bottom.label"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
