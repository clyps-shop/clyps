      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 32,
      "label": "t:sections.clyps_bundle_builder.settings.padding_top_mobile.label"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 32,
      "label": "t:sections.clyps_bundle_builder.settings.padding_bottom_mobile.label"
    }
  ],
  "blocks": [
    {
      "type": "set",
      "name": "t:sections.clyps_bundle_builder.blocks.set.name",
      "limit": 3,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.clyps_bundle_builder.blocks.set.settings.title.label"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "t:sections.clyps_bundle_builder.blocks.set.settings.badge.label",
          "info": "t:sections.clyps_bundle_builder.blocks.set.settings.badge.info"
        },
        {
          "type": "product",
          "id": "clip_1",
          "label": "t:sections.clyps_bundle_builder.blocks.set.settings.clip_1.label"
