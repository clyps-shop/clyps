{%- comment -%}
  clyps Badges
  Renders tag-based badges configured in Theme settings > Badges for a given product.
  Accepts:
    - product: {Object} product to check tags against
    - class: {String} optional extra classes for positioning/layout
{%- endcomment -%}
<div class="clyps-badges pointer-events-none flex flex-wrap items-start gap-1 empty:hidden{% if class %} {{ class }}{% endif %}">
  {%- for i in (1..10) -%}
    {%- liquid
      assign clyps_badge_tag_key = 'badge_' | append: i | append: '_tag'
      assign clyps_badge_text_key = 'badge_' | append: i | append: '_text'
      assign clyps_badge_tag = settings[clyps_badge_tag_key] | strip
      assign clyps_badge_text = settings[clyps_badge_text_key]
    -%}
    {%- if clyps_badge_tag != blank and clyps_badge_text != blank and product.tags contains clyps_badge_tag -%}
      {%- liquid
        assign clyps_badge_bg_key = 'badge_' | append: i | append: '_background_color'
        assign clyps_badge_color_key = 'badge_' | append: i | append: '_text_color'
        assign clyps_badge_bg = settings[clyps_badge_bg_key]
        assign clyps_badge_color = settings[clyps_badge_color_key]
      -%}
      <span class="clyps-badge inline-flex items-center rounded-full px-3 py-1 text-xs font-medium leading-none whitespace-nowrap" style="background-color: {{ clyps_badge_bg | escape }}; color: {{ clyps_badge_color | escape }};">{{ clyps_badge_text | escape }}</span>
    {%- endif -%}
  {%- endfor -%}
</div>
