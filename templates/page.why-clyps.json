ackground_color_light":"rgba(0,0,0,0)","heading_dark":"rgba(0,0,0,0)","color_heading_highlight_dark":"rgba(0,0,0,0)","text_dark":"rgba(0,0,0,0)","background_color_dark":"rgba(0,0,0,0)","content_alignment":"left","show_section_divider":false,"make_full_page_width":false,"padding_top":28,"padding_bottom":28,"content_alignment_mobile":"center","show_section_divider_mobile":false,"padding_top_mobile":28,"padding_bottom_mobile":28}},"rich_text_3XeLwN":{"type":"rich-text","blocks":{"heading_JezJjc":{"type":"heading","settings":{"heading":"Nicht die Ohrclips, die du kennst","highlight_type":"underline","heading_size":100,"heading_tag":"h2"}},"text_Pt6gh4":{"type":"text","settings":{"text":"<p>Viele haben bei Ohrclips das Bild von klobigen, altmodischen Designs im Kopf. Abgeklemmte Ohrläppchen, Druck und Schmerz durch harte, zuschnappende Verschlüsse.<\/p>","number_of_lines_shown":"none","read_more_label":"Read more","see_less_label":"See less"}},"caption_PJhAqK":{"type":"caption","settings":{"caption":"Wir kennen das. Und genau deshalb gibt es CLYPS.","text_style":"uppercase","text_size":100}}},"block_order":["heading_JezJjc","text_Pt6gh4","caption_PJhAqK"],"name":"t:sections.rich-text.name","settings":{"heading_light":"rgba(0,0,0,0)","color_heading_highlight_light":"rgba(0,0,0,0)","text_light":"rgba(0,0,0,0)","background_color_light":"#f2efeb","heading_dark":"rgba(0,0,0,0)","color_heading_highlight_dark":"rgba(0,0,0,0)","text_dark":"rgba(0,0,0,0)","background_color_dark":"rgba(0,0,0,0)","content_alignment":"center","show_section_divider":false,"make_full_page_width":true,"padding_top":28,"padding_bottom":28,"content_alignment_mobile":"center","show_section_divider_mobile":false,"padding_top_mobile":28,"padding_bottom_mobile":28}},"multicolumn_wXG3YY":{"type":"multicolumn","blocks":{"column_ayB4Dc":{"type":"column","settings":{"icon":"truck","another_icon":"","custom_image":"shopify:\/\/shop_images\/Clip.svg","custom_icon":"","title":"Innovative, unsichtbare Clipverschlüsse","highlight_type":"underline","title_link":"shopify:\/\/pages\/how-to-clyps","open_new_window":false,"heading_size":100,"text":"<p>Unsere Clipverschlüsse sind so entwickelt, dass sie bequem sitzen und sicheren Halt geben. CLYPS passen sich an deine Bedürfnisse an und sind für jedes Ohr gemacht. <\/p><p>Die Verschlüsse sind transparent und damit so unauffällig, dass kein Unterschied zu klassischen Ohrringen sichtbar ist. <\/p>"}},"column_fyP7iw":{"type":"column","settings":{"icon":"truck","another_icon":"","custom_image":"shopify:\/\/shop_images\/Langlebig.svg","custom_icon":"","title":"Premium-Materialien als Begleiter für deinen Alltag","highlight_type":"underline","title_link":"shopify:\/\/pages\/material-pflege","open_new_window":false,"heading_size":100,"text":"<p>Wir setzen auf hautverträgliche Premium-Materialien und eine langlebige, farbechte PVD-Beschichtung.<\/p><p>So sind deine CLYPS wasserfest und besonders pflegeleicht.<\/p>"}},"column_WyRFYt":{"type":"column","settings":{"icon":"truck","another_icon":"","custom_image":"shopify:\/\/shop_images\/Hautfreundlich.svg","custom_icon":"","title":"Modernes, zeitloses Design","highlight_type":"underline","title_link":"shopify:\/\/collections\/all","open_new_window":false,"heading_size":100,"text":"<p>CLYPS sind nicht \"Ohrclips für Menschen ohne Piercing\". Sie sind einfach Ohrschmuck. Punkt.<\/p><p>Modern. Stilvoll. Elegant.<\/p>"}}},"block_order":["column_ayB4Dc","column_fyP7iw","column_WyRFYt"],"name":"t:sections.multicolumn.name","settings":{"title":"Was CLYPS anders macht","highlight_type":"underline","heading_size":100,"heading_tag":"h2","secondary_background":"column","border_column":"full_border","column_content_alignment":"start","icon_position":"above","icon_size":45,"enable_desktop_slider":true,"swiper_on_mobile":false,"enable_arrow_mobile":false,"auto_play":true,"change_bar_every":5,"background_color_light":"#f2efeb","heading_light":"rgba(0,0,0,0)","text_light":"rgba(0,0,0,0)","color_heading_highlig